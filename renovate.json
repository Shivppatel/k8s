{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "enabledManagers": [
    "helmv3",
    "helm-values",
    "kubernetes",
    "custom.regex"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)apps/[^/]+/[^/]+\\.ya?ml$/"
    ]
  },
  "labels": [
    "dependencies",
    "renovate"
  ],
  "packageRules": [
    {
      "description": "Group and automerge non-major Helm chart dependency updates",
      "matchManagers": [
        "helmv3"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major Helm chart dependencies",
      "groupSlug": "all-non-major-helm-chart-dependencies",
      "automerge": true
    },
    {
      "description": "Never automerge major Helm chart dependency updates",
      "matchManagers": [
        "helmv3"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Group container image updates",
      "matchManagers": [
        "helm-values",
        "kubernetes",
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "groupName": "all container image updates",
      "groupSlug": "all-container-image-updates",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track scalar image references in Helm values and Kubernetes YAML",
      "managerFilePatterns": [
        "/(^|/)values\\.ya?ml$/",
        "/(^|/)templates/.+\\.ya?ml$/",
        "/(^|/)apps/[^/]+/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:-\\s*)?image:\\s*[\\\"']?(?:[^\\s\\\"'/:]+/)*[^\\s\\\"'/:]+:(?<currentValue>[^\\s\\\"']+)[\\\"']?\\s+#\\s*renovate:\\s+datasource=docker\\s+depName=(?<depName>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
