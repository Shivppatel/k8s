{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "enabledManagers": [
    "helmv3",
    "helm-values",
    "kubernetes",
    "custom.regex"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)apps/[^/]+/[^/]+\\.ya?ml$/"
    ]
  },
  "labels": [
    "dependencies",
    "renovate"
  ],
  "packageRules": [
    {
      "description": "Group and automerge non-major Helm chart dependency updates",
      "matchManagers": [
        "helmv3"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major Helm chart dependencies",
      "groupSlug": "all-non-major-helm-chart-dependencies",
      "automerge": true
    },
    {
      "description": "Never automerge major Helm chart dependency updates",
      "matchManagers": [
        "helmv3"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Group container image updates",
      "matchManagers": [
        "helm-values",
        "kubernetes",
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "groupName": "all container image updates",
      "groupSlug": "all-container-image-updates",
      "automerge": false
    },
    {
      "description": "Pre-1.0 images can break on a minor bump (Atlantis 0.49 dropped its bundled terraform, 2026-10-26): give each its own PR",
      "matchDatasources": [
        "docker"
      ],
      "matchCurrentVersion": "/^v?0\\./",
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "groupName": null,
      "groupSlug": null,
      "automerge": false,
      "addLabels": [
        "review-release-notes"
      ],
      "prBodyNotes": [
        "This is a pre-1.0 minor/major image update and is split out of the grouped image PR. Read the release notes for removed features or changed defaults before merging, and watch the app's pods after Argo syncs."
      ]
    },
    {
      "description": "Platform-critical images get their own PR for every update",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/runatlantis/atlantis",
        "/^quay\\.io/argoproj//",
        "/(^|/)hashicorp/vault$/",
        "/^ghcr\\.io/cloudnative-pg//",
        "/^longhornio//"
      ],
      "groupName": null,
      "groupSlug": null,
      "automerge": false,
      "addLabels": [
        "platform-critical"
      ],
      "prBodyNotes": [
        "Platform-critical image: review release notes and confirm the workload is Healthy in Argo CD after sync."
      ]
    },
    {
      "description": "Freeze EMQX chart and image until clustered deployment licensing is resolved",
      "matchPackageNames": [
        "emqx",
        "emqx/emqx"
      ],
      "enabled": false
    },
    {
      "description": "Freeze LocalStack chart and image; manually verify license activation and storage compatibility before upgrades",
      "matchPackageNames": [
        "localstack",
        "localstack/localstack"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track scalar image references in Helm values and Kubernetes YAML",
      "managerFilePatterns": [
        "/(^|/)values\\.ya?ml$/",
        "/(^|/)templates/.+\\.ya?ml$/",
        "/(^|/)apps/[^/]+/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:-\\s*)?image:\\s*[\\\"']?(?:[^\\s\\\"'/:]+/)*[^\\s\\\"'/:]+:(?<currentValue>[^\\s\\\"']+)[\\\"']?\\s+#\\s*renovate:\\s+datasource=docker\\s+depName=(?<depName>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
